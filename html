<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KOVALYUK | Стример, геймер, угар</title>
    <meta name="description" content="CS2, GTA V RP, Dota Turbo, PUBG, Hearthstone — нарезки, стримы и много угара!">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        :root {
            --bg: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            --text: #e0e0ff;
            --accent: #00ff88;
            --card: rgba(30, 30, 60, 0.7);
            --border: rgba(0, 255, 136, 0.3);
        }
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background-attachment: fixed;
        }
        .container {
            max-width: 420px;
            width: 100%;
            text-align: center;
        }
        .avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid var(--accent);
            box-shadow: 0 0 30px rgba(0,255,136,0.4);
            margin: 0 auto 20px;
            object-fit: cover;
            background: #111;
        }
        h1 {
            font-size: 2.8rem;
            margin-bottom: 8px;
            text-shadow: 0 0 20px rgba(0,255,136,0.5);
        }
        .bio {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 30px;
            line-height: 1.4;
        }
        .links {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 40px;
        }
        .link {
            background: var(--card);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            color: white;
            text-decoration: none;
            padding: 18px 24px;
            border-radius: 50px;
            font-size: 1.15rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        .link:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,255,136,0.25);
            border-color: var(--accent);
        }
        .link i { font-size: 1.4rem; color: var(--accent); }
        .section-title {
            font-size: 1.4rem;
            margin: 40px 0 20px;
            color: var(--accent);
            text-shadow: 0 0 15px rgba(0,255,136,0.4);
        }
        .pc-specs {
            background: var(--card);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            text-align: left;
            font-size: 1.1rem;
            line-height: 1.6;
        }
        .pc-specs strong { color: var(--accent); }
        .emoji { font-size: 1.4rem; margin-right: 8px; }
        @media (max-width: 500px) {
            h1 { font-size: 2.4rem; }
            .bio { font-size: 1.1rem; }
        }
    </style>
</head>
